<?xml version="1.0"?>
<package format="3">
  <name>detection_mono</name>
  <version>0.0.1</version>
  <description>
    Camera-only 2D detection → pseudo-3D node using size-prior back-projection.
    Estimates depth as Z = fy * real_height / pixel_height from class size priors.
    No LiDAR required.
  </description>

  <maintainer email="sosoalt@ucsd.edu">Spencer Soalt</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
