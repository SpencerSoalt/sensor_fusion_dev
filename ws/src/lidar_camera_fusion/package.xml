<?xml version="1.0"?>
<package format="3">
  <name>lidar_camera_fusion</name>
  <version>0.0.1</version>
  <description>LiDAR-camera fusion node: projects PointCloud2 into Detection2DArray bounding boxes to produce Detection3DArray with estimated depth/position.</description>

  <maintainer email="sosoalt@ucsd.edu">Spencer Soalt</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <!-- numpy/opencv/open3d installed via pip/apt in runtime env -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
